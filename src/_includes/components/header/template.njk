{#- A version of the GOV.UK Frontend header without the crown or GOV.UK logotype.
    Based on node_modules/govuk-frontend/dist/govuk/components/header/template.njk
    and node_modules/govuk-frontend/dist/govuk/components/generic-header/template.njk -#}
{% from "../../../../node_modules/govuk-frontend/dist/govuk/macros/attributes.njk" import govukAttributes -%}

<header class="govuk-header app-header {%- if params.classes %} {{ params.classes }}{% endif %}"
  {{- govukAttributes(params.attributes) }}>
  <div class="govuk-header__container {{ params.containerClasses | default("govuk-width-container", true) }}">
    <div class="govuk-header__logo app-header__logo">
      <a href="{{ params.homepageUrl | default("/", true) }}" class="govuk-header__homepage-link">
        <span class="app-header__product-name">
          {{- params.productName -}}
        </span>
      </a>
    </div>
  </div>
</header>
